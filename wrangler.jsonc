{
  // トキノート：Cloudflare Workers の設定
  "name": "tokinote",
  "main": "worker/index.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "FAMILY", "class_name": "Family" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Family"] }],
  "observability": { "enabled": true }
}
